# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE GESTIÓN HOSPITALARIA & EMR (PRODUCCIÓN & DESARROLLO)
# ==============================================================================

# Entorno y Puerto
NODE_ENV=production
PORT=5000

# Seguridad de Tokens JWT (¡CAMBIAR POR CLAVES LARGAS Y ALEATORIAS EN PRODUCCIÓN!)
JWT_SECRET=super_secret_jwt_key_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_key_hospital_emr_production
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes Permitidos para CORS (Frontend en Vercel o URL local)
# Puedes especificar la URL de tu frontend en Vercel o usar '*' para permitir todas
CORS_ORIGIN=https://tu-frontend.vercel.app,http://localhost:3000,http://localhost:5000

# ==============================================================================
# OPCIÓN A: CONEXIÓN A BASE DE DATOS EN LA NUBE (RECOMENDADO PARA PRODUCCIÓN)
# ==============================================================================

# 1. EJEMPLO PARA NEON (https://neon.tech):
# DATABASE_URL=postgresql://usuario:contraseña@ep-cool-flower-123456.us-east-2.aws.neon.tech/hospital_db?sslmode=require

# 2. EJEMPLO PARA SUPABASE (https://supabase.com):
# Conexión directa (Puerto 5432):
# DATABASE_URL=postgresql://postgres:tu_contraseña_aqui@db.abcdefghijklmnopqrst.supabase.co:5432/postgres
# Conexión con Connection Pooler (Puerto 6543 - Recomendado para Serverless):
# DATABASE_URL=postgresql://postgres.abcdefghijklmnopqrst:tu_contraseña@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 3. EJEMPLO PARA RENDER / RAILWAY POSTGRESQL:
# DATABASE_URL=postgresql://postgres:contraseña@monorail.proxy.rlwy.net:12345/railway

# Forzar SSL (true para cualquier base de datos en la nube, false para PostgreSQL local)
DB_SSL=true

# ==============================================================================
# OPCIÓN B: CONEXIÓN LOCAL (DESARROLLO EN TU PC CON PGADMIN)
# ==============================================================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_contraseña_local
# DB_NAME=hospital_db
# DATABASE_URL=postgresql://postgres:tu_contraseña_local@localhost:5432/hospital_db
# DB_SSL=false
